<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jeu de Devinette"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Affichage du pendu -->
    <ImageView
        android:id="@+id/iv_pendu"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerInside"
        android:layout_marginBottom="20dp"
        android:src="@drawable/ic_launcher_background" />

    <!-- Compteur de tentatives -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tentatives : "
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tentatives"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_red_dark"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <!-- Plage de nombre -->
    <TextView
        android:id="@+id/tv_plage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trouvez un nombre entre 1 et 100"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Saisie et bouton (80% EditText, 20% Bouton) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:spacing="10dp">

        <EditText
            android:id="@+id/et_deviner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="0.8"
            android:inputType="number"
            android:hint="Entrez votre nombre"
            android:padding="10dp"
            android:background="@drawable/edit_text_bg"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btn_confirmer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="0.2"
            android:text="OK"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Résultat -->
    <TextView
        android:id="@+id/tv_resultat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Entrez un nombre et cliquez sur OK"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/result_bg"
        android:textColor="@android:color/white" />

    <!-- Bouton recommencer -->
    <Button
        android:id="@+id/btn_recommencer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recommencer"
        android:layout_marginTop="20dp" />

</LinearLayout>